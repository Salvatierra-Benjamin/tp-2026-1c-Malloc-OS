{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(gdb) Debuggear Swap",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/swap/bin/swap",
      "args": [
        "sp.config"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/swap",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Habilitar formato para gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}